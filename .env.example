# Copy to .env and fill in. The .env file itself is gitignored.
#
# ---------------------------------------------------------------------------
# Setting up the database
#
# Easiest: give the setup script a Supabase personal access token and let it
# do the work. Account Preferences -> Access Tokens -> Generate new token.
#
#   SUPABASE_ACCESS_TOKEN=sbp_...
#
# Then run:
#
#   node tools/supabase-setup.js
#
# It creates the project, waits for the database, reads the pooler
# configuration and writes DATABASE_URL into this file. The password never
# appears on the terminal.
# ---------------------------------------------------------------------------

# The database connection string. The setup script writes this for you.
#
# Supabase: Project Settings -> Database -> Connection string -> Session pooler.
# Use the **Session pooler** URI, not the Transaction pooler — node-postgres
# does not turn off prepared statements, and the transaction pooler is meant
# for clients that can. The session pooler URI looks like this:
#
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Any Postgres works — Neon, Vercel Postgres or your own server. Keep
# ?sslmode=require if the provider gives you that option; the server reads it
# and negotiates TLS accordingly.
#
# Leave it empty to run without cloud accounts: the game falls back to
# per-device local accounts and everything still works.
DATABASE_URL=

# Supabase personal access token, used only by tools/supabase-setup.js.
# Not needed by the game or the API.
SUPABASE_ACCESS_TOKEN=
